{
  "name": "@caliper/ask",
  "version": "0.1.0",
  "description": "MCP server that lets a coding agent ask the developer to review ambiguous UI regions directly in the running dev preview.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenDiem/caliper.git",
    "directory": "apps/mcp-server"
  },
  "homepage": "https://github.com/DenDiem/caliper/tree/main/apps/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/DenDiem/caliper/issues"
  },
  "keywords": ["mcp", "claude-code", "codex", "design-review", "ui-review"],
  "type": "module",
  "publishConfig": {"access": "public"},
  "engines": {"node": ">=20"},
  "bin": {"caliper": "./dist/cli.js"},
  "files": ["dist", "skills"],
  "scripts": {
    "build": "tsup && pnpm run build:client",
    "build:client": "vite build -c client/vite.config.ts",
    "demo": "tsx demo/server.ts",
    "demo:review": "tsx demo/review.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "http-proxy": "^1.18.1",
    "open": "^10.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@caliper/core": "workspace:*",
    "@caliper/overlay": "workspace:*",
    "@preact/preset-vite": "^2.9.0",
    "@preact/signals": "^1.3.0",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.7.0",
    "preact": "^10.24.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "vite": "^5.4.0"
  }
}
